# EduTrack Pro site block — rendered by deploy.sh (tokens: __HOST__, __ROOT__, __API__).
# Host Caddy: installed to /etc/caddy/sites/gheras.caddy and imported by /etc/caddy/Caddyfile.
__HOST__ {
	encode zstd gzip
	root * __ROOT__

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; font-src 'self' https://fonts.gstatic.com; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self';"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# REST API (FastAPI / uvicorn)
	handle /api/* {
		reverse_proxy __API__
	}

	# Landing → dashboard
	redir / /web/dashboard/ 302

	# Static allow-list: the dashboard, the 11 print templates and the logo.
	# Everything else in the tree (db/, server/, deploy/, notes) stays unreachable.
	@notes path *.md *.MD
	handle @notes {
		respond 404
	}
	handle /web/* {
		header Cache-Control "no-cache, must-revalidate"
		file_server
	}
	handle /assets/* {
		header Content-Disposition "attachment; filename=EduTrackPro.apk"
		header -Vary
		file_server
	}
	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/gheras.access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
