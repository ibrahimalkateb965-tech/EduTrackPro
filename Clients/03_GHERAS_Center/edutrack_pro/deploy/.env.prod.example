# deploy/.env — generated by deploy.sh on first run (chmod 600). Never commit the real file.
POSTGRES_PASSWORD=<generated>
GHERAS_APP_PASSWORD=<generated>
JWT_SECRET=<generated 64 hex chars>
JWT_TTL_MINUTES=720
MOBILE_JWT_TTL_MINUTES=43200
# Same-origin deployment: the dashboard is served by the same host, so no CORS origins are needed.
CORS_ORIGINS=
MAIN_BRANCH_ID=00000000-0000-0000-0000-000000000001
